<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>الدخول إلى لوحة المدير - المعرفة الذكية</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #090910;
      color: #fff;
      font-family: system-ui, -apple-system, sans-serif;
      padding: 20px;
    }
    .card {
      width: 100%;
      max-width: 420px;
      background: #131320;
      border: 1px solid #2a2a40;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    }
    h1 {
      font-size: 20px;
      margin: 0 0 8px;
      text-align: center;
    }
    p.sub {
      font-size: 13px;
      color: #b8b8d0;
      text-align: center;
      margin: 0 0 20px;
    }
    input {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid #383854;
      background: #0c0c14;
      color: #fff;
      font-size: 15px;
      margin-bottom: 12px;
    }
    button {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: none;
      background: #6d4aff;
      color: #fff;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      margin-bottom: 10px;
    }
    .secondary-btn {
      background: #1e1e30;
      border: 1px solid #383854;
    }
    #msg {
      font-size: 13px;
      text-align: center;
      color: #fbbf24;
      min-height: 20px;
      margin-top: 8px;
    }
    a.back {
      display: block;
      text-align: center;
      margin-top: 14px;
      color: #93c5fd;
      text-decoration: none;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>الدخول إلى لوحة المدير</h1>
    <p class="sub">أدخل كلمة مرور المدير أو استخدم QR / NFC للتحقق</p>

    <input type="password" id="adminPass" placeholder="أدخل كلمة مرور المدير" />
    <button type="button" id="passBtn">دخول بكلمة المرور</button>

    <button type="button" class="secondary-btn" id="qrBtn">مسح QR بالكاميرا</button>
    <button type="button" class="secondary-btn" id="nfcBtn">قراءة بطاقة NFC</button>

    <div id="msg"></div>
    <a class="back" href="index.html">العودة إلى الصفحة الرئيسية</a>
  </div>

  <script>
    const msg = document.getElementById('msg');
    document.getElementById('passBtn').addEventListener('click', () => {
      const val = document.getElementById('adminPass').value.trim();
      if (!val) {
        msg.textContent = 'يرجى إدخال كلمة المرور أولاً.';
        return;
      }
      msg.textContent = 'تم إرسال طلب التحقق...';
    });

    document.getElementById('qrBtn').addEventListener('click', () => {
      msg.textContent = 'جاري تجهيز ماسح QR...';
    });

    document.getElementById('nfcBtn').addEventListener('click', () => {
      msg.textContent = 'جاري تجهيز قراءة NFC...';
    });
  </script>
</body>
</html>
